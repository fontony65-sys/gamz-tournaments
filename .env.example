# Copy to .env for local use, or set these in Render → your service → Environment. Never commit real values.
#
# Turso (hosted libSQL) — create a NEW database just for gamz. Leave both empty to use the local file db/gamz.db.
# (This app only ever reads these two GAMZ_* names, never any other database variable.)
GAMZ_DATABASE_URL=libsql://gamz-your-account.turso.io
GAMZ_DATABASE_TOKEN=
#
# Admin login. ADMIN_PASSWORD is REQUIRED when NODE_ENV=production (8+ characters).
# Locally, if it is empty, a random one is generated and saved in .admin-password.local
ADMIN_USER=admin
ADMIN_PASSWORD=
NODE_ENV=production
#
# Optional
# ALLOW_SIGNUP=false closes public player sign-up
ALLOW_SIGNUP=true
# Failed logins allowed per IP per 15 minutes
LOGIN_MAX_ATTEMPTS=10
# SESSION_SECRET is NOT needed: sessions are random tokens stored (hashed) in the database.
# PORT is set automatically by Render; defaults to 3000 locally.
PORT=3000
